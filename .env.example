# Development only. Production requires a long random SECRET_KEY.
SECRET_KEY=
FLASK_ENV=development
DATABASE_URL=sqlite:///text_summarizer.db
HOST=127.0.0.1
PORT=5000
SUMMARIZER_BACKEND=auto
MODEL_NAME=sshleifer/distilbart-cnn-12-6
# Auto mode uses cached weights by default and falls back immediately if absent.
# Run flask --app run download-model to download the model explicitly.
MODEL_ALLOW_DOWNLOAD=false
SESSION_COOKIE_SECURE=false

